<Window x:Class="Tractus.PresenterTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tractus Presenter Test for NDI" Width="1220" Height="860"
        MinWidth="980" MinHeight="720" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}" Foreground="#F5F8FC">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="TRACTUS" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="14" />
                <TextBlock Text="Presenter Test for NDI" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Eight distinguishable 1920×1080p30 sources with synchronized audio identification."
                           Foreground="#9FB1C5" FontSize="14" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StartButton" Content="Start Sources" Click="StartButton_Click" Background="#1B8D72" Foreground="White" />
                <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" Background="#692C38" Foreground="White" IsEnabled="False" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="2.4*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Source name prefix" Foreground="#9FB1C5" />
                    <TextBox x:Name="NamePrefixTextBox" ToolTip="Sources appear as PREFIX 1 through PREFIX 8." />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Sources" Foreground="#9FB1C5" />
                    <ComboBox x:Name="SourceCountComboBox" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Tone level (dBFS)" Foreground="#9FB1C5" />
                    <TextBox x:Name="ToneLevelTextBox" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Chase seconds" Foreground="#9FB1C5" />
                    <TextBox x:Name="ChaseSecondsTextBox" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Audio program" Foreground="#9FB1C5" />
                    <WrapPanel>
                        <Button Content="Individual" Click="IndividualButton_Click" />
                        <Button Content="Tone All" Click="ToneAllButton_Click" />
                        <Button Content="Silence All" Click="SilenceAllButton_Click" />
                        <Button Content="Tone Chase" Click="ToneChaseButton_Click" Background="#245E75" Foreground="White" />
                    </WrapPanel>
                </StackPanel>

                <Grid Grid.Row="1" Grid.ColumnSpan="5" Margin="4,10,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="Ready — sources are stopped" Foreground="#B9C7D6" FontWeight="SemiBold" />
                    <TextBlock x:Name="ProgramText" Grid.Column="1" Text="SILENCE ALL" Foreground="{StaticResource Accent}" FontWeight="Bold" />
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="6" Background="{StaticResource PanelBackground}" BorderThickness="2" CornerRadius="10"
                                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChaseActive}" Value="True">
                                            <Setter Property="BorderBrush" Value="#F0C94D" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasFailure}" Value="True">
                                            <Setter Property="BorderBrush" Value="#E05263" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="130" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Image Source="{Binding PreviewPath}" Stretch="UniformToFill" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                                    <Button Content="Change image" Tag="{Binding Number}" Click="ChangeImageButton_Click"
                                            IsEnabled="{Binding CanChangeImage}" Style="{StaticResource CompactButtonStyle}"
                                            ToolTip="Use your own image for this presenter." />
                                    <Button Content="Default" Tag="{Binding Number}" Click="ResetImageButton_Click"
                                            IsEnabled="{Binding CanChangeImage}" Style="{StaticResource CompactButtonStyle}"
                                            Visibility="{Binding IsCustomImage, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="Restore the bundled presenter silhouette." />
                                </StackPanel>
                                <Border Background="#B20A0F18" VerticalAlignment="Bottom" Padding="10,6">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Number}" FontSize="24" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="{Binding ChaseBadge}" DockPanel.Dock="Right" VerticalAlignment="Center"
                                                   Foreground="#F0C94D" FontWeight="Bold" />
                                    </DockPanel>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="12">
                                    <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StatusLine}" Foreground="#9FB1C5" Margin="0,4,0,8" />
                                    <ComboBox ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding SelectedMode, Mode=TwoWay}" />
                                    <TextBlock Text="{Binding FrequencyLabel}" Foreground="#7FD5DD" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="4,16,4,0">
            <TextBlock Foreground="#71859B" FontSize="12"
                       Text="NDI® is a registered trademark of Vizrt NDI AB. Audio off defaults to silence so channel presence remains stable." />
            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Foreground="#71859B" FontSize="12" Text="v1.1.0" />
        </Grid>
    </Grid>
</Window>
